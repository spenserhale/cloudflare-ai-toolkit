# Cloudflare API Configuration
#
# Prefer the OS keychain over this file: `cloudflare auth set api-token` stores
# the token without plaintext, and `cloudflare auth migrate` copies values from
# here into the keychain (then delete them here; a .env value overrides the
# keychain). Precedence: process env > nearest .env > keychain.
CLOUDFLARE_API_TOKEN=your-api-token-here
# Legacy fallback auth (used only if CLOUDFLARE_API_TOKEN is not set)
# CLOUDFLARE_API_KEY=your-global-api-key-here
# CLOUDFLARE_EMAIL=you@example.com
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_BASE_URL=https://api.cloudflare.com
# Skip the OS keychain lookup (CI, headless Linux without a Secret Service).
# CLOUDFLARE_KEYCHAIN=0
